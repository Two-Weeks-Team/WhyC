# =============================================================================
# WhyC environment variables — example file
#
# DO NOT EDIT `.env` DIRECTLY. The operator (Sejun) edits `.env` by hand only,
# never via tooling. CI / Docker / Cloud Run reads from Secret Manager — this
# file is the schema reference + local-dev seed.
#
# Categories:
#   1. Database (Cloud SQL Postgres)
#   2. Vendor APIs (Gemini, Phoenix Cloud)
#   3. Web/API URLs + CORS
#   4. Rate limiting (mirrors Cloud Armor caps in deploy/cloud-armor/policy.yaml)
#   5. Pipeline tunables (judge prompt version, ceilings)
#   6. Local-dev only (docker-compose)
# =============================================================================

# ---- 1. Database -----------------------------------------------------------
# Production: read-only DB user, connection pool sized per SPEC §2.1
#   connection_limit=3 × max-instances=5 = 15 ≤ Postgres pool size
DATABASE_URL=postgresql://whyc:CHANGE_ME@127.0.0.1:5432/whyc?schema=public&connection_limit=3&pool_timeout=10
# Production secret refs (Cloud Run uses --set-secrets, this is documentation):
#   - whyc-database-url           (web-tier read-only)
#   - whyc-database-url-writer    (jobs writer)

# ---- 2. Vendor APIs --------------------------------------------------------
# Gemini API: in production this comes via Application Default Credentials on
# Cloud Run (Secret Manager-backed). In local-dev set the key directly.
GEMINI_API_KEY=

# Arize Phoenix Cloud (SaaS).  Free tier: 50k traces/month.  Rotate every 90 days.
ARIZE_PHOENIX_API_KEY=
ARIZE_PHOENIX_ENDPOINT=https://app.phoenix.arize.com

# ---- 3. Web/API URLs + CORS ------------------------------------------------
# Public-facing base for the API (used by Next.js client + SSR).
NEXT_PUBLIC_API_BASE=http://localhost:8081/api/v1
# Where the web tier lives (used in absolute redirects, OG tags, etc).
WEB_BASE_URL=http://localhost:3000
# CORS allowlist for the API (comma-separated; production should be a single origin).
CORS_ALLOWED_ORIGIN=http://localhost:3000

# ---- 4. Rate limiting (mirrors Cloud Armor) --------------------------------
# In-app limiter is a backstop; primary enforcement is at Cloud Armor.
RATE_LIMIT_COMPANIES_PER_MIN=60
RATE_LIMIT_RUNS_PER_MIN=60
RATE_LIMIT_HEALTH_PER_MIN=600
RATE_LIMIT_STATS_PER_MIN=600

# ---- 5. Pipeline tunables --------------------------------------------------
# These are also pinned per-Run in DB (Run.judgePromptVersion, Run.iterLimit,
# Run.costLimitCents) — env values are kickoff defaults only.
JUDGE_PROMPT_VERSION=v1
ITER_LIMIT=7
COST_LIMIT_CENTS=500
TAU_CONVERGE=0.92
TAU_FLOOR=0.50
KICKOFF_BATCH_SIZE=12

# ---- 6. Local-dev only (docker-compose) ------------------------------------
POSTGRES_DB=whyc
POSTGRES_USER=whyc
POSTGRES_PASSWORD=whyc-local-dev-only

# ---- 7. Observability + ops ------------------------------------------------
LOG_LEVEL=info
NODE_ENV=production

# =============================================================================
# Production secrets (NEVER set here — populated via Secret Manager):
#   - whyc-database-url             projects/$PROJECT_ID/secrets/whyc-database-url
#   - whyc-database-url-writer      projects/$PROJECT_ID/secrets/whyc-database-url-writer
#   - whyc-gemini-api-key           projects/$PROJECT_ID/secrets/whyc-gemini-api-key
#   - whyc-phoenix-api-key          projects/$PROJECT_ID/secrets/whyc-phoenix-api-key
#
# Rotation cadence:
#   - Phoenix key:    90 days
#   - Gemini key:     90 days
#   - Database creds: 180 days
# =============================================================================
