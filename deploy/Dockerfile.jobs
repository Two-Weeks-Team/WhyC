# syntax=docker/dockerfile:1.7
# WhyC pipeline jobs (Cloud Run Jobs) — multi-stage image
# Build context: repo root.  Build:  docker build -f deploy/Dockerfile.jobs -t whyc-jobs .
#
# This image runs `apps/jobs/dist/main.js`, which dispatches on $WHYC_JOB
# (pipeline_kickoff / scrape_yc / sweep_deploys / refresh_hires /
# public_stats_rebuild). The v4 pipeline shells out to the hooks/ scripts —
# which need python3 (the .sh hooks parse JSON via python3; on-*.py are python3
# scripts). node:20-slim (debian bookworm-slim) ships bash + sha256sum but NOT
# python3, so the runtime stage installs it (closes the G7 gap for this image).

# ---- 1. base ----------------------------------------------------------------
FROM node:20-slim AS base
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    NODE_ENV=production \
    CI=true
# keep this in sync with package.json's "packageManager" field
RUN corepack enable && corepack prepare pnpm@9.12.0 --activate
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates openssl tini \
 && rm -rf /var/lib/apt/lists/*

# ---- 2. deps (cached install) ----------------------------------------------
FROM base AS deps
WORKDIR /app
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY apps/jobs/package.json ./apps/jobs/
COPY prisma/schema.prisma ./prisma/schema.prisma
# --prod=false: base sets NODE_ENV=production which would skip devDeps (we need
# typescript for the build).
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --prod=false --filter "@whyc/jobs..." --filter "."
RUN pnpm --filter @whyc/jobs exec prisma generate --schema=../../prisma/schema.prisma

# ---- 3. builder -------------------------------------------------------------
FROM deps AS builder
WORKDIR /app
COPY apps/jobs ./apps/jobs
COPY prisma ./prisma
RUN pnpm --filter @whyc/jobs run build

# ---- 4. runtime -------------------------------------------------------------
# NOTE: ship the full (devDeps-included) install from `builder` — the pruned
# variant produced an image where runtime deps were unresolvable from
# apps/jobs/dist/main.js (same MODULE_NOT_FOUND class as Dockerfile.api).
# Copying `builder`'s node_modules verbatim (incl. generated Prisma client) is
# the reliable path; size cost is acceptable for a job image.
FROM node:20-slim AS runtime
ENV NODE_ENV=production \
    NODE_OPTIONS="--enable-source-maps" \
    WHYC_REPO_ROOT=/app
# bash + python3 + jq for the v4 hook layer; tini as PID 1; openssl for prisma.
# (node:20-slim is debian bookworm-slim — bash is not guaranteed, install it.)
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates openssl tini bash python3 jq \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --system --gid 10001 nodejs \
 && useradd  --system --uid 10001 --gid nodejs --no-create-home --shell /usr/sbin/nologin whyc

WORKDIR /app

# built JS + node_modules (with generated Prisma client) + the files the runtime reads
COPY --from=builder --chown=whyc:nodejs /app/apps/jobs/dist          ./apps/jobs/dist
COPY --from=builder --chown=whyc:nodejs /app/apps/jobs/package.json  ./apps/jobs/package.json
COPY --from=builder --chown=whyc:nodejs /app/node_modules            ./node_modules
COPY --from=builder --chown=whyc:nodejs /app/apps/jobs/node_modules  ./apps/jobs/node_modules
COPY --from=builder --chown=whyc:nodejs /app/prisma                  ./prisma
# v4 hook layer + agent registry + per-run template (the pipeline shells into these)
COPY --chown=whyc:nodejs hooks/                                        ./hooks/
COPY --chown=whyc:nodejs agents/                                       ./agents/
COPY --chown=whyc:nodejs runs/.template/                               ./runs/.template/
COPY --chown=whyc:nodejs package.json                                  ./package.json

USER whyc:nodejs

# Self-check at build time: the hook layer must run in this image.
RUN bash hooks/smoke-test.sh

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["node", "apps/jobs/dist/main.js"]
